ENVIRONMENT=development
PROJECT_NAME=IT Helpdesk Agent
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite+aiosqlite:///./it_agent.db
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
# Optional development administrator; set both values to bootstrap an account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=60
CHROMA_PERSIST_DIRECTORY=.chroma
KNOWLEDGE_COLLECTION_NAME=it_helpdesk_knowledge
KNOWLEDGE_RETRIEVAL_K=4
KNOWLEDGE_MIN_SCORE=0.3
